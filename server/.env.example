# Local dev: leave DATABASE_URL unset to use a local file database (server/medstudy.db).
# Production (Vercel + Turso): set both of these to your Turso database credentials.
# DATABASE_URL=libsql://your-db-name.turso.io
# DATABASE_AUTH_TOKEN=your-turso-auth-token

PORT=4000
JWT_SECRET=change-this-in-production-medstudy-secret-key
CLIENT_ORIGIN=*
