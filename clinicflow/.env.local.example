# ─────────────────────────────────────────────────────────────
# Supabase
# Dashboard → Project Settings → API
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Dashboard → Project Settings → API → service_role.
# Never expose this to the browser. Used for admin tasks (e.g. billing activation).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL — used to build auth email redirect links.
# Local dev: http://localhost:3000   Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
